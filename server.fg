/; =========================================================
/;  The Career Compiler — served by Flow-Wing
/;
/;  This is a Flow-Wing program. The Flow-Wing compiler
/;  (C++/LLVM) compiles/runs THIS file, and this program
/;  then serves the portfolio over HTTP using the built-in
/;  `vortex` module — exactly how flow-wing's own website
/;  runs on Flow-Wing (see flowwing-explorer/flow-wing-website
/;  in github.com/kushagra1212/Flow-Wing).
/;
/;  So "served by Flow-Wing" is literal, not metaphor.
/;
/;  Run (AOT):
/;      flowwing server.fg -o career && ./career
/;      ./career "<mongo-uri>" "<admin-token>"
/;
/;  Args (both optional):
/;    arg1 — MONGO_URI    (fallback: mongodb://127.0.0.1:27017)
/;    arg2 — ADMIN_TOKEN  (fallback: dev-admin-token)
/;
/;  Then open:   http://127.0.0.1:8080
/;               http://127.0.0.1:8080/admin/<token>
/;
/;  ---- Shape of this server ----
/;
/;  The accept loop is a TASK, not top-level code:
/;
/;      fg_main()  ->  spawn serverLoop(app, events)  ->  spawn handleRequest(...)
/;
/;  That matters. `spawn` queues work, and the queue only drains once the
/;  top-level body has finished. A `while true` loop at the top level never
/;  finishes, so handlers queued inside it would never run at all. Once the
/;  loop is itself a task, accept() can suspend it and the scheduler runs the
/;  queued handlers while it waits for the next connection.
/; =========================================================

bring vortex
bring file
bring text
bring io
bring Err
bring sys
bring mongo

/; =========================================================
/;  Start-up caches
/;
/;  Filled once in fg_main, read by every handler afterwards. index.html and
/;  admin.html used to be read from disk on EVERY request, which cost a file
/;  open, a full read and a fresh garbage-collected string each time. They do
/;  not change while the process runs, so they are read once.
/;
/;  Globals on purpose: a spawned task can read them without them being copied
/;  into every argument block.
/; =========================================================
var gIndexHtml: str = ""
var gAdminHtml: str = ""
var gAdminPathPrefix: str = ""
var gAdminEventsPath: str = ""
var gCurrentDir: str = "."

/; Read a file once at start-up. A missing file is a warning, not a crash —
/; the matching route then answers 500 instead of the server refusing to boot.
fun preload(path: str, what: str) -> str {
    var body: str, e: Err::Result = file::readText(path)
    if Err::isErr(e) {
        io::printErrorLogln("could not preload " + what + " (" + path + ")", "yellow")
        return ""
    }
    io::printLogln("cached " + what + " (" + String(text::length(body)) + " bytes)", "green")
    return body
}

fun mimeFor(p: text::Text) -> str {
    var contentType: str = "application/octet-stream"
    if p.endsWith(".css") {
        contentType = "text/css; charset=utf-8"
    } else if p.endsWith(".js") {
        contentType = "text/javascript; charset=utf-8"
    } else if p.endsWith(".svg") {
        contentType = "image/svg+xml"
    } else if p.endsWith(".png") {
        contentType = "image/png"
    } else if p.endsWith(".webmanifest") {
        contentType = "application/manifest+json"
    } else if p.endsWith(".ico") {
        contentType = "image/x-icon"
    } else if p.endsWith(".html") {
        contentType = "text/html; charset=utf-8"
    }
    return contentType
}

/; =========================================================
/;  GET /admin/<token>/events
/;
/;  This used to build one giant string:
/;
/;      arr = arr + s          /; inside a 2000-iteration loop
/;
/;  Every `+` allocates a NEW string holding everything so far, so 2000
/;  documents of ~200 bytes allocate and copy on the order of 400 MB in total
/;  just to produce a 400 KB reply — and the collector has to walk all of it.
/;
/;  Streaming writes each document straight to the socket instead. Nothing
/;  larger than one document is ever held in memory, and the cost becomes
/;  linear in the number of documents.
/; =========================================================
fun sendEvents(res: vortex::Response, events: mongo::Collection) -> nthg {
    /; findSorted, not find. The sort is what makes `lim` mean "the 2000 most
    /; recent" rather than "the 2000 oldest".
    /;
    /; find(filter, limit) cannot express an order, so Mongo answers in natural
    /; order — roughly insertion order, oldest first. That stayed invisible while
    /; this collection held under 2000 documents, because "the oldest 2000" and
    /; "all of them" were the same set. Past 2000 the cap began returning only the
    /; oldest 2000; admin.js:79-84 then dropped everything outside the selected
    /; range, which was all of them, and the dashboard went blank while /track
    /; kept answering 204. The reply measured 642801 bytes — about 2000 documents
    /; of ~321 bytes — so the cap was saturated exactly.
    /;
    /; An explicit newest-first sort removes the guesswork. Truncation now drops
    /; the OLDEST events, the only end that is safe to lose, and every option in
    /; the range selector works — including "all time", which a server-side date
    /; window would have silently capped.
    /;
    /; Requires mongo::Collection.findSorted, added after 1.0.14. Against an older
    /; compiler this fails with FunctionNotFound on this line — a build-time
    /; error, not a runtime surprise.
    var allFilter: str = "{}"
    var lim: int64 = 2000
    var newestFirst: str = "{\"ts\": -1}"
    var cur: mongo::Cursor = events.findSorted(allFilter, lim, newestFirst)

    res.status(200).streamBegin("application/json")
    res.streamWrite("[")

    var s: str = cur.next()
    var first: bool = true
    while s != "" {
        if first {
            first = false
        } else {
            res.streamWrite(",")
        }
        res.streamWrite(s)
        s = cur.next()
    }

    res.streamWrite("]")
    res.streamEnd()
    cur.close()
}

/; =========================================================
/;  One request. Runs as its own task.
/;
/;  Routes are ordered by how often they are hit, so the common case does the
/;  fewest comparisons. `new text::Text(path)` is built only in the /assets/
/;  branch — it used to be allocated for every request, including "/".
/; =========================================================
fun handleRequest(req: vortex::Request, res: vortex::Response,
                  events: mongo::Collection) -> nthg {
    var method: str = req.getMethod()
    var path: str = req.getPath()

    /; === GET / -> the portfolio itself (served from memory) ===
    if method == "GET" && path == "/" {
        if gIndexHtml == "" {
            res.status(500).header("Content-Type", "text/html").send("<h1>Missing index.html</h1>")
        } else {
            res.status(200).header("Content-Type", "text/html; charset=utf-8").send(gIndexHtml)
        }
        return :
    }

    /; === POST /track -> ingest one event JSON doc ===
    if method == "POST" && path == "/track" {
        var body: str = req.getBody()
        if body == "" {
            res.status(400).header("Content-Type", "text/plain").send("empty body")
            return :
        }
        if events.insertOne(body) {
            res.status(204).send("")
        } else {
            io::printErrorLogln("track insert failed: " + mongo::lastError(), "red")
            res.status(500).header("Content-Type", "text/plain").send("track failed")
        }
        return :
    }

    /; === GET /assets/* -> css / js / icons (correct MIME) ===
    if method == "GET" {
        var pathAsText: text::Text = new text::Text(path)
        if pathAsText.startsWith("/assets/") {
            res.status(200).sendStaticFile(gCurrentDir + pathAsText.get(), mimeFor(pathAsText))
            return :
        }
    }

    /; === GET /admin/<token>/events -> JSON feed of recent events ===
    if method == "GET" && path == gAdminEventsPath {
        sendEvents(res, events)
        return :
    }

    /; === GET /admin/<token> -> admin dashboard HTML (served from memory) ===
    if method == "GET" && path == gAdminPathPrefix {
        if gAdminHtml == "" {
            res.status(500).header("Content-Type", "text/html").send("<h1>admin page missing</h1>")
        } else {
            res.status(200).header("Content-Type", "text/html; charset=utf-8").send(gAdminHtml)
        }
        return :
    }

    /; === GET /career.fg -> the Flow-Wing source, in the open ===
    if method == "GET" && (path == "/career.fg" || path == "/server.fg") {
        res.status(200).sendStaticFile(gCurrentDir + path, "text/plain; charset=utf-8")
        return :
    }

    /; === everything else ===
    res.status(404).header("Content-Type", "text/html").send("<h1>404 — not a route in this build</h1>")
}

/; =========================================================
/;  The accept loop, as a task.
/;
/;  Two spawns matter here, and they do different jobs:
/;
/;    spawn serverLoop(...)   lets accept() SUSPEND instead of owning the
/;                            thread, so queued handlers get to run
/;    spawn handleRequest(..) returns to accept() at once, so the kernel's
/;                            backlog keeps draining while a handler works
/; =========================================================
fun serverLoop(app: vortex::Server, events: mongo::Collection) -> nthg {
    while true {
        var req: vortex::Request, res: vortex::Response = app.accept()
        if req == null {
            continue
        }
        spawn handleRequest(req, res, events)
    }
}

fun fg_main() -> nthg {
    gCurrentDir = file::__DIR__ == "" ? "." : file::__DIR__

    /; ---- read CLI args for prod config ----
    var mongoUri: str = sys::getArg(1)
    if mongoUri == "" {
        mongoUri = "mongodb://127.0.0.1:27017"
        io::printLogln("MONGO_URI not provided (arg1), using local mongod", "yellow")
    }
    var adminToken: str = sys::getArg(2)
    if adminToken == "" {
        adminToken = "dev-admin-token"
        io::printLogln("ADMIN_TOKEN not provided (arg2), using dev fallback", "yellow")
    }
    gAdminPathPrefix = "/admin/" + adminToken
    gAdminEventsPath = gAdminPathPrefix + "/events"

    /; ---- open mongo BEFORE binding the socket (libmongoc init plays poorly
    /;      with whatever vortex sets up at listen time) ----
    var mc: mongo::Client = new mongo::Client(mongoUri)
    if !mc.isOk() {
        io::printErrorLogln("mongo connect failed: " + mongo::lastError(), "red")
        return :
    }
    var dbName: str = "portfolio"
    var collName: str = "events"
    var events: mongo::Collection = mc.getCollection(dbName, collName)
    /; Never log mongoUri. An Atlas URI carries the password in plain text, and
    /; this line wrote it into `docker logs` on every start — where it sits on
    /; disk and ends up pasted into bug reports. The database name confirms the
    /; right target without leaking the credential.
    io::printLogln("mongo connected (db " + dbName + ")", "green")

    /; ---- read the pages that never change, once ----
    gIndexHtml = preload(gCurrentDir + "/index.html", "index.html")
    gAdminHtml = preload(gCurrentDir + "/assets/admin.html", "admin.html")

    /; ---- now bind the vortex server ----
    var app: vortex::Server = new vortex::Server()
    var err: Err::Result = app.listen(8080)
    if Err::isErr(err) {
        io::printErrorLogln("Failed to bind :8080 — is it already in use?", "red")
        mc.close()
        return :
    }

    io::printLogln("The Career Compiler — served by Flow-Wing at http://127.0.0.1:8080", "cyan")

    /; Queues the loop. It starts when fg_main returns and the top-level body
    /; finishes — which is exactly why the loop is not written inline here.
    spawn serverLoop(app, events)
}

fg_main()
