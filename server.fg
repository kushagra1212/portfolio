/; =========================================================
/;  The Career Compiler — served by Flow-Wing
/;
/;  This is a Flow-Wing program. The Flow-Wing compiler
/;  (C++/LLVM) compiles/runs THIS file, and this program
/;  then serves the portfolio over HTTP using the built-in
/;  `vortex` module — exactly how flow-wing's own website
/;  runs on Flow-Wing (see flowwing-explorer/flow-wing-website
/;  in github.com/kushagra1212/Flow-Wing).
/;
/;  So "served by Flow-Wing" is literal, not metaphor.
/;
/;  Run (AOT):
/;      flowwing server.fg -o career && ./career
/;      ./career "<mongo-uri>" "<admin-token>"
/;
/;  Args (both optional):
/;    arg1 — MONGO_URI    (fallback: mongodb://127.0.0.1:27017)
/;    arg2 — ADMIN_TOKEN  (fallback: dev-admin-token)
/;
/;  Then open:   http://127.0.0.1:8080
/;               http://127.0.0.1:8080/admin/<token>
/; =========================================================

bring vortex
bring file
bring text
bring io
bring Err
bring sys
bring mongo

fun fg_main() -> nthg {
    const CURRENT_DIR: str = file::__DIR__ == "" ? "." : file::__DIR__

    /; ---- read CLI args for prod config ----
    var mongoUri: str = sys::getArg(1)
    if mongoUri == "" {
        mongoUri = "mongodb://127.0.0.1:27017"
        io::printLogln("MONGO_URI not provided (arg1), using local mongod", "yellow")
    }
    var adminToken: str = sys::getArg(2)
    if adminToken == "" {
        adminToken = "dev-admin-token"
        io::printLogln("ADMIN_TOKEN not provided (arg2), using dev fallback", "yellow")
    }
    var adminPathPrefix: str = "/admin/" + adminToken
    var adminEventsPath: str = adminPathPrefix + "/events"

    /; ---- open mongo BEFORE binding the socket (libmongoc init plays poorly
    /;      with whatever vortex sets up at listen time) ----
    var mc: mongo::Client = new mongo::Client(mongoUri)
    if !mc.isOk() {
        io::printErrorLogln("mongo connect failed: " + mongo::lastError(), "red")
        return :
    }
    var dbName: str = "portfolio"
    var collName: str = "events"
    var events: mongo::Collection = mc.getCollection(dbName, collName)
    io::printLogln("mongo connected: " + mongoUri, "green")

    /; ---- now bind the vortex server ----
    var app: vortex::Server = new vortex::Server()
    var err: Err::Result = app.listen(8080)
    if Err::isErr(err) {
        io::printErrorLogln("Failed to bind :8080 — is it already in use?", "red")
        mc.close()
        return :
    }

    io::printLogln("The Career Compiler — served by Flow-Wing at http://127.0.0.1:8080", "cyan")

    while true {
        var req: vortex::Request, res: vortex::Response = app.accept()
        if req == null {
            continue
        }

        var method: str = req.getMethod()
        var path: str = req.getPath()
        var pathAsText: text::Text = new text::Text(path)

        /; === POST /track -> ingest one event JSON doc ===
        if method == "POST" && path == "/track" {
            var body: str = req.getBody()
            if body == "" {
                res.status(400).header("Content-Type", "text/plain").send("empty body")
            } else {
                var ok: bool = events.insertOne(body)
                if ok {
                    res.status(204).send("")
                } else {
                    var emsg: str = mongo::lastError()
                    io::printErrorLogln("track insert failed: " + emsg, "red")
                    res.status(500).header("Content-Type", "text/plain").send("track failed")
                }
            }
        }
        /; === GET /admin/<token>/events -> JSON feed of recent events ===
        else if method == "GET" && path == adminEventsPath {
            var allFilter: str = "{}"
            var lim: int64 = 2000
            var cur: mongo::Cursor = events.find(allFilter, lim)
            var s: str = cur.next()
            var arr: str = "["
            var first: bool = true
            while s != "" {
                if first {
                    first = false
                } else {
                    arr = arr + ","
                }
                arr = arr + s
                s = cur.next()
            }
            arr = arr + "]"
            cur.close()
            res.status(200).header("Content-Type", "application/json").send(arr)
        }
        /; === GET /admin/<token> -> admin dashboard HTML ===
        else if method == "GET" && path == adminPathPrefix {
            var adminPath: str = CURRENT_DIR + "/assets/admin.html"
            var html: str, herr: Err::Result = file::readText(adminPath)
            if Err::isErr(herr) {
                res.status(500).header("Content-Type", "text/html").send("<h1>admin page missing</h1>")
            } else {
                res.status(200).header("Content-Type", "text/html; charset=utf-8").send(html)
            }
        }
        /; === GET / -> the portfolio itself ===
        else if method == "GET" && path == "/" {
            var indexPath: str = CURRENT_DIR + "/index.html"
            var content: str, rerr: Err::Result = file::readText(indexPath)
            if Err::isErr(rerr) {
                res.status(500).header("Content-Type", "text/html").send("<h1>Missing index.html</h1>")
            } else {
                res.status(200).header("Content-Type", "text/html; charset=utf-8").send(content)
            }
        }
        /; === GET /assets/* -> css / js / icons (correct MIME) ===
        else if method == "GET" && pathAsText.startsWith("/assets/") {
            var assetPath: str = CURRENT_DIR + pathAsText.get()
            var contentType: str = "application/octet-stream"
            if pathAsText.endsWith(".css") {
                contentType = "text/css; charset=utf-8"
            } else if pathAsText.endsWith(".js") {
                contentType = "text/javascript; charset=utf-8"
            } else if pathAsText.endsWith(".svg") {
                contentType = "image/svg+xml"
            } else if pathAsText.endsWith(".png") {
                contentType = "image/png"
            } else if pathAsText.endsWith(".webmanifest") {
                contentType = "application/manifest+json"
            } else if pathAsText.endsWith(".ico") {
                contentType = "image/x-icon"
            } else if pathAsText.endsWith(".html") {
                contentType = "text/html; charset=utf-8"
            }
            res.status(200).sendStaticFile(assetPath, contentType)
        }
        /; === GET /career.fg -> the Flow-Wing source, in the open ===
        else if method == "GET" && (path == "/career.fg" || path == "/server.fg") {
            res.status(200).sendStaticFile(CURRENT_DIR + path, "text/plain; charset=utf-8")
        }
        /; === everything else ===
        else {
            res.status(404).header("Content-Type", "text/html").send("<h1>404 — not a route in this build</h1>")
        }
    }
}

fg_main()
